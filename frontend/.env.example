# Copy this file to .env and fill in values after deploying contracts to testnet.
# Never commit .env to version control.

VITE_NETWORK=testnet

# Backend REST API (defaults to http://localhost:3000)
VITE_API_URL=

# Deployed Soroban contract IDs (run `stellar contract deploy` to get these)
VITE_ESCROW_CONTRACT_ID=
VITE_DISPUTE_CONTRACT_ID=
VITE_REPUTATION_CONTRACT_ID=

# USDC on Stellar testnet (Circle's testnet USDC asset contract)
VITE_USDC_CONTRACT_ID=

# Stellar Asset Contract for native XLM (used if a job pays in XLM)
VITE_XLM_CONTRACT_ID=

# Source account public key used to *simulate* public reads (escrow state,
# reputation). Reads never sign and never charge this account, so by default the
# frontend uses a built-in, secret-less all-zero key and needs nothing here —
# /jobs/:id and /profile/:address render before any wallet connects.
# Set this to any funded public key only if your RPC provider rejects
# simulations whose source account is not on the ledger. Never put a secret here.
VITE_READONLY_SOURCE=

# Fiat estimates beside amounts (issue #76). Optional: CoinGecko's keyless
# feed is the default and works with no configuration at all. Set the URL to
# point at a proxy or a self-hosted mirror, and the key to send a CoinGecko
# demo key (raised rate limit). An unavailable feed just means no estimate.
VITE_PRICE_API_URL=
VITE_PRICE_API_KEY=
