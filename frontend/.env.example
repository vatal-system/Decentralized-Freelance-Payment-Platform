# Copy this file to .env and fill in values after deploying contracts to testnet.
# Never commit .env to version control.

VITE_NETWORK=testnet

# Deployed Soroban contract IDs (run `stellar contract deploy` to get these)
VITE_ESCROW_CONTRACT_ID=
VITE_DISPUTE_CONTRACT_ID=
VITE_REPUTATION_CONTRACT_ID=

# USDC on Stellar testnet (Circle's testnet USDC asset contract)
VITE_USDC_CONTRACT_ID=
