# Copy to .env — never commit .env

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelance_stellar"

# JWT — must be at least 32 characters; generate with: openssl rand -base64 32
JWT_SECRET=change_me_in_production_replace_with_a_32plus_char_secret

# Stellar network
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract IDs (fill after `stellar contract deploy`)
ESCROW_CONTRACT_ID=
DISPUTE_CONTRACT_ID=
REPUTATION_CONTRACT_ID=
USDC_CONTRACT_ID=
# Stellar Asset Contract for native XLM (used only if a job pays in XLM)
XLM_CONTRACT_ID=

# Comma-separated Stellar addresses allowed to resolve disputes through the
# API. Leave empty to disable dispute resolution entirely (the route fails
# closed). The on-chain dispute contract is still the final authority.
ARBITRATOR_ADDRESSES=

# Comma-separated browser origins allowed to call this API, e.g. the deployed
# frontend. Empty allows every origin (fine locally, warned about in
# production).
CORS_ORIGIN=

# Indexer: how often to poll for new contract events (ms)
INDEXER_POLL_INTERVAL_MS=5000
