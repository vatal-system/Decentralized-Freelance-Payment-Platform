{
  "name": "decentralized-freelance-payment-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized freelance payment platform on Stellar",
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "npm --prefix frontend run lint",
    "fmt:contracts": "cargo fmt --manifest-path contracts/Cargo.toml --all -- --check",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:e2e:frontend": "npm --prefix frontend run test:e2e"
  },
  "lint-staged": {
    "contracts/**/*.rs": "cargo fmt --manifest-path contracts/Cargo.toml --all -- --check",
    "frontend/**/*.{js,jsx,ts,tsx}": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1"
  }
}
